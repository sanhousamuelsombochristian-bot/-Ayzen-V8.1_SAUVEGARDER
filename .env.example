# Copy to .env for local development. Never commit a populated .env.
# Alembic reads DATABASE_URL from the process environment; do not put production credentials here.
DATABASE_URL=postgresql+psycopg://ayzenai:change_me@127.0.0.1:5432/ayzenai

# Ollama runs on the AyzenAI backend host. The browser must not use this URL directly.
AYZENAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AYZENAI_OLLAMA_API_KEY=
AYZENAI_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
AYZENAI_PROVIDER_READ_TIMEOUT_SECONDS=180
AYZENAI_PROVIDER_MAX_RETRIES=1
AYZENAI_MAX_CONCURRENT_GENERATIONS=1
AYZENAI_DEFAULT_CONTEXT_TOKENS=8192
AYZENAI_MAX_OUTPUT_TOKENS=2048
AYZENAI_LOCAL_ONLY=true

# Defaults for provisioning only; after migrations, model_profiles.model_name is authoritative.
# Environment variables must not silently override an existing database profile mapping.
AYZENAI_PROFILE_OMNI_LIGHT=qwen2.5:1.5b
AYZENAI_PROFILE_OMNI_TEXT=qwen3:8b
AYZENAI_PROFILE_OMNI_VISION=qwen3-vl:4b
AYZENAI_PROFILE_THINKING=qwen3:8b

# Proposed privacy defaults; confirm before network exposure.
AYZENAI_CONVERSATION_RETENTION_DAYS=90
AYZENAI_TECHNICAL_LOG_RETENTION_DAYS=30
AYZENAI_AUDIT_RETENTION_DAYS=180
AYZENAI_BACKUP_RETENTION_DAYS=30

# Optional OAuth: leave unset in offline/local-only use. Configure only with verified OIDC values.
AYZENAI_GOOGLE_CLIENT_ID=
AYZENAI_GOOGLE_CLIENT_SECRET=
AYZENAI_GOOGLE_REDIRECT_URI=

# Set only to the dedicated disposable local PostgreSQL database named ayzenai_test.
AYZENAI_TEST_DATABASE_URL=postgresql+psycopg://ayzenai_test:change_me@127.0.0.1:5432/ayzenai_test
